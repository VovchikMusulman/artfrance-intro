{
  "name": "artfrance-intro",
  "version": "1.0.0",
  "description": "Добавляет корпоративное интро в начало видео",
  "main": "src/main.js",
  "author": "ART France",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder --win portable"
  },
  "build": {
    "appId": "fr.artfrance.intro",
    "productName": "ART France Intro",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "node_modules/ffmpeg-static/ffmpeg.exe",
        "to": "ffmpeg/ffmpeg.exe"
      },
      {
        "from": "assets/intro.mp4",
        "to": "assets/intro.mp4"
      }
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "ART-France-Intro-${version}-portable.${ext}"
    },
    "portable": {
      "artifactName": "ART-France-Intro-${version}-portable.exe"
    }
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "dependencies": {
    "ffmpeg-static": "^5.2.0"
  }
}
